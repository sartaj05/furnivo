# SQLite works with no configuration. For PostgreSQL/MySQL, set DATABASE_URL.
DATABASE_URL=sqlite:///furnivo.db
# PostgreSQL example: postgresql+psycopg://user:password@localhost/furnivo
# MySQL example: mysql+pymysql://user:password@localhost/furnivo
SECRET_KEY=replace-me
JWT_SECRET_KEY=replace-me-too
JWT_ACCESS_TOKEN_EXPIRES=3600
REFRESH_TOKEN_DAYS=30
FRONTEND_ORIGINS=http://localhost:5173
MAX_CONTENT_LENGTH=8388608
# Optional. If set, uploads use Cloudinary; otherwise files are saved locally.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=furnivo
AUTO_SEED=true
ENVIRONMENT=development
APP_VERSION=furnivo-v3
RATE_LIMIT_PER_MINUTE=120
DEFAULT_DEPOSIT_PERCENT=30
BACKUP_FOLDER=backend/backups
EINVOICE_PROVIDER=demo
PAYMENT_LIVE_REFUNDS=false
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:5173/#/app/invoices
PAYMENT_CANCEL_URL=http://localhost:5173/#/app/invoices
# Prefer HTTP email delivery on Render Free; SMTP is only a local fallback.
NOTIFICATION_EMAIL_URL=
NOTIFICATION_EMAIL_TOKEN=
NOTIFICATION_FROM_EMAIL=notifications@furnivo.local
WHATSAPP_WEBHOOK_URL=
SMS_WEBHOOK_URL=
# Optional Twilio fallback for live SMS and WhatsApp delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK=
